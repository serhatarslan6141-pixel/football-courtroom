# Backend only. Copy to .env in the project root; never use VITE_ for secrets.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Disabled unless explicitly enabled. No AI calls occur during app startup.
FOUNDRY_LIVE_ENABLED=false
FOUNDRY_DAILY_REQUEST_CAP=10
FOUNDRY_MAX_OUTPUT_TOKENS=32
FOUNDRY_TIMEOUT_SECONDS=30
# Extra attempts, each counted against the daily cap. CLI always uses zero.
FOUNDRY_MAX_RETRIES=0
# Phase 4B additionally requires request allow_live=true. Disabled by default.
COURTROOM_LIVE_ENABLED=false
# A complete trial needs four calls. Lower limits stop safely with fallback.
COURTROOM_MAX_MODEL_CALLS=4
# Effective output ceiling is the MINIMUM of this and FOUNDRY_MAX_OUTPUT_TOKENS.
# For a later approved trial, set the global ceiling to 256 in that process.
COURTROOM_MAX_OUTPUT_TOKENS=256
# UTF-8 byte ceiling includes the complete serialized model request body.
COURTROOM_MAX_INPUT_BYTES=128000
